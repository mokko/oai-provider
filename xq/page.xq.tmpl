(: One page of ListIdentifiers / ListRecords.

   Paging is a keyset cursor on (datestamp, identifier), not an offset, and
   the pair has to be a TOTAL order: datestamp alone is not unique (the real
   MuseumPlus data has records sharing a second), and a cursor that is not
   unique either skips the peers or repeats them. Skipping is the dangerous
   one - the harvest still ends with an empty page, so the harvester believes
   it is complete.

   $until is pinned on the first page and carried in the resumption token, so
   a re-ingest during a harvest cannot move a record across a page boundary.

   **The payload is fetched after the page is chosen, not before.** {{SOURCE}}
   yields headers only, so the order-by sorts rows it can afford to carry, and
   only the page's rows get a payload attached, from {{PAYLOADS}}. Attaching
   payloads in the source and then sorting them was the whole cost of
   ListRecords: page_size=1 and page_size=100 measured the same, because all
   5,884 matching records were materialised and then discarded.
:)
{{NAMESPACES}}
{{FORMAT_NAMESPACES}}
{{OAI_DATE_FUNCTION}}
{{ZETCOM_FUNCTION}}

declare option output:indent "no";

declare variable $db external;
(: absolute path to vocmap.xml, for the related-works ISIL lookup. An unbound
   external variable is an error, so it is always bound even when unused. :)
declare variable $vocmap external;
(: the configured offset, used when a datestamp is normalized out of a local
   wall clock (module mode reads the record's own __lastModified). :)
declare variable $tzOffset external;
declare variable $set external;
declare variable $from external;
declare variable $until external;
declare variable $afterDs external;
declare variable $afterId external;
(: typed: external variables arrive as untyped strings, so $limit + 1 would
   otherwise fail with "Arithmetics not defined for xs:string and xs:integer".
   Declaring the type makes BaseX cast on bind, and rejects a bad binding
   early instead of silently comparing as text. :)
declare variable $limit as xs:integer external;
declare variable $withPayload external;
(: True only on the FIRST page of a harvest. Then the total is counted from
   this same scan (the cursor is empty, so $matching IS the pinned result
   set), and the caller issues no separate COUNT query. A resume carries the
   total in its token and passes false, so it pays for nothing it does not
   use. :)
declare variable $wantTotal external;

let $rows := {{SOURCE}}

let $matching :=
  for $r in $rows
  where ($from = '' or $r/@datestamp ge $from)
    and ($until = '' or $r/@datestamp le $until)
    (: tokenize, not contains: a space-joined attribute tested with contains
       would match 'art' inside 'earth'. A record with no sets tokenizes to the
       empty sequence, which never equals a real setSpec. :)
    and ($set = '' or $set = tokenize(string($r/@sets), '\s+'))
    and ($afterDs = ''
         or $r/@datestamp gt $afterDs
         or ($r/@datestamp eq $afterDs
             and $r/@identifier gt $afterId))
  order by $r/@datestamp ascending,
           $r/@identifier ascending
  return $r

(: limit + 1, so the caller can tell whether another page exists without a
   second query. :)
let $wanted := subsequence($matching, 1, $limit + 1)
let $payloads := if ($withPayload = 'true') then {{PAYLOADS}} else ()

(: count() over an already-materialised sequence adds no scan; it is the whole
   point of asking the page for its own total. :)
let $total_attr :=
  if ($wantTotal = 'true') then attribute total { count($matching) } else ()

return
  <page>{ $total_attr }{
    for $r in $wanted
    return
      <row datestamp="{$r/@datestamp}"
           identifier="{$r/@identifier}"
           status="{$r/@status}"
           sets="{$r/@sets}">{
        $payloads[@id = $r/@identifier]/node()
      }</row>
  }</page>
