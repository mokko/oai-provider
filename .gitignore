.venv/
__pycache__/
*.pyc
.pytest_cache/

# Deployment settings: the address to be reached at, and credentials.
# `.env.example` is the tracked template.
.env

# Museum data samples. Large (a single RIA chunk is ~200 MB unpacked) and not
# ours to publish, so **nothing in here is ever committed or pushed**. The
# directory is expected to exist locally and to stay out of git entirely.
sdata/

# `uv pip install` run inside the project directory writes a lockfile as a side
# effect. Nothing depends on it, this project pins nothing, and the documented
# workflow is `uv pip install --python ./.venv/bin/python ...` - so it is noise
# here rather than a dependency decision. Ignored; delete this rule if a lock is
# ever wanted deliberately (then commit it on purpose).
uv.lock

