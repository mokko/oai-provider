(: Ingest one big multi-record file into an OAI envelope per record.

   Updating query: it stores and returns nothing. BaseX does not allow an
   updating expression to be mixed with a returning one, so the report you
   get before storing comes from validate.xq.tmpl instead.

   Everything variable - database, path, prefix, offset, dump id - arrives
   as an external variable, so it cannot break out of the query text.
:)
{{NAMESPACES}}

declare variable $path external;
declare variable $db external;
declare variable $idPrefix external;
declare variable $tzOffset external;
declare variable $dumpId external;

{{OAI_DATE_FUNCTION}}

let $doc := parse-xml(file:read-text($path))

for $r in {{RECORD_XPATH}}
let $identifier := concat($idPrefix, {{IDENTIFIER_EXPR}})
let $datestamp := local:oaiDate(string({{DATESTAMP_EXPR}}), $tzOffset)
let $sets := distinct-values((
    {{SET_EXPRESSIONS}}
))
(: Skip silently is not acceptable: the validate pass reports these before
   we ever write. Guard anyway so a bad dump cannot store half-records. :)
return if ({{IDENTIFIER_EXPR}} ne '' and $datestamp) then
  db:put($db,
    <{{ENVELOPE_PREFIX}}:record
        {{ENVELOPE_PREFIX}}:identifier="{$identifier}"
        {{ENVELOPE_PREFIX}}:datestamp="{$datestamp}"
        {{ENVELOPE_PREFIX}}:seen="{$dumpId}">
      { for $s in $sets return <{{ENVELOPE_PREFIX}}:set>{$s}</{{ENVELOPE_PREFIX}}:set> }
      (: The source element, unaltered. Nothing is filtered: what Zetcom
         emitted is what gets stored and served. :)
      <{{ENVELOPE_PREFIX}}:source>{$r}</{{ENVELOPE_PREFIX}}:source>
    </{{ENVELOPE_PREFIX}}:record>,
    concat(replace($identifier, '[^A-Za-z0-9._-]', '_'), '.xml'))
else ()
