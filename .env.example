# Copy to `.env` and fill in. `.env` is gitignored; this file is the template.
#
# The address a harvester calls back. Identify echoes it and harvesters dial
# it, so it must be the address this deployment is reachable at. Left as
# localhost, the shipped placeholder secrets are accepted; set it to a real
# off-host address and the two secrets below become REQUIRED (the config
# refuses to start otherwise - see oai/config.py: check_secrets).
OAI_BASE_URL=http://localhost:8000/oai

# BaseX credentials. Prefer these over basex.password in the config file.
# OAI_BASEX_PASSWORD=

# HMAC key that signs resumption tokens. Without it - or with the shipped
# placeholder - tokens are forgeable. Generate one:  python3 -c "import
# secrets; print(secrets.token_urlsafe(32))"
# OAI_TOKEN_SECRET=

# Where to read this from, if not `.env` beside the config file.
# OAI_ENV_FILE=/etc/oai-provider.env
