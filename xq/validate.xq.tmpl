(: Dry run: what *would* the mapping extract from this dump?

   Read-only, so it can report per-record detail - which the ingest pass
   cannot, because a query is either updating or returning, never both.
   Run this first; it is the only place a bad mapping shows up as a message
   rather than as records quietly missing from the database.
:)
{{NAMESPACES}}

declare option output:indent "yes";

declare variable $path external;
declare variable $idPrefix external;
declare variable $tzOffset external;

{{OAI_DATE_FUNCTION}}

let $doc := parse-xml(file:read-text($path))
let $rows :=
  for $r at $pos in {{RECORD_XPATH}}
  let $id := {{IDENTIFIER_EXPR}}
  let $datestamp := local:oaiDate(string({{DATESTAMP_EXPR}}), $tzOffset)
  let $sets := distinct-values(({{SET_EXPRESSIONS}}))
  return
    <record position="{$pos}"
            identifier="{concat($idPrefix, $id)}"
            datestamp="{$datestamp}"
            sets="{string-join($sets, ' ')}"
            storable="{($id ne '' and $datestamp) cast as xs:boolean}"/>

return
  <validate records="{count($rows)}"
            storable="{count($rows[@storable = 'true'])}"
            missing="{count($rows[@storable = 'false'])}">
    { $rows }
  </validate>
