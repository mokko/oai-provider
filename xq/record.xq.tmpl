(: One record by identifier, for GetRecord. Returns nothing if absent, so
   the caller can raise idDoesNotExist. A tombstone yields the header with no
   payload - GetRecord for a deleted record must not invent metadata.

   The identifier is globally unique because each module tags its records with
   its own prefix (EM-object-, EM-person-, EM-asset-), so a search across all
   sources finds exactly one - the caller need not know which database holds it.
:)
{{NAMESPACES}}
{{FORMAT_NAMESPACES}}
{{OAI_DATE_FUNCTION}}

declare variable $db external;
declare variable $tzOffset external;
declare variable $identifier external;
declare variable $withPayload external;

let $rows := {{SOURCE}}
return
  if (empty($rows[@identifier = $identifier])) then ()
  else $rows[@identifier = $identifier]
