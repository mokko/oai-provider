(: How many stored records are absent from this dump? Read-only, so the
   reconcile pass (which is updating and therefore cannot report) can still
   be summarised honestly. A document-count delta cannot do this job:
   under policy "persistent" a tombstone keeps its document, so the count
   is unchanged no matter how many records were deleted.
:)
{{NAMESPACES}}

declare variable $db external;
declare variable $dumpId external;

count(
  for $d in collection($db)
  where not($d/{{ENVELOPE_PREFIX}}:record/@{{ENVELOPE_PREFIX}}:seen = $dumpId)
  return $d)
